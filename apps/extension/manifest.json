{
  "manifest_version": 3,
  "name": "MUSOU-EC コネクタ",
  "version": "0.2.0",
  "description": "MUSOU-EC の拡張連携ツール（楽天サジェスト・検索順位・競合/ページ解析）を、あなたのブラウザから直接実行します。サーバープロキシは使いません。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.rakuten.co.jp/*",
    "https://*.yahoo.co.jp/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "MUSOU-EC コネクタ" },
  "content_scripts": [
    {
      "matches": [
        "https://knotscheme.github.io/musou-ec/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
